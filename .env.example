# Copy to .env for local development. Never commit real values.
# Generate secrets with: openssl rand -base64 48   (hex key: openssl rand -hex 32)

NODE_ENV=development

# --- API (apps/api) ---
PORT=4000
DATABASE_URL=postgresql://hp:hp_local_dev_only@localhost:5442/hearthandpan
REDIS_URL=redis://localhost:6389
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters
# Derives guest order-lookup tokens (emailed links). Rotating it invalidates old links.
ORDER_LOOKUP_SECRET=replace-with-at-least-32-random-characters
# Shared by the API and the storefront server: SSR requests send it as X-Internal-Token
# so the API rate-limits by the shopper address they forward in X-HP-Client-IP. Required in production.
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
# Reverse proxies in front of the API: 1 on Render, 2 with Cloudflare proxying to Render
TRUST_PROXY_HOPS=1
# Exact origins of the two frontends (CORS, CSRF origin check, cookie selection)
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
# redis in every deployed environment; memory only for single-process local runs
RATE_LIMIT_STORE=redis
LOG_LEVEL=info
RESERVATION_TTL_MINUTES=15

# Payments: "fake" runs checkout without a card provider (local dev only; refused in production).
# "amwal" is Amwal Pay (Oman, SmartBox); AMWAL_ENV=uat until Amwal enables your live merchant.
# In the Amwal portal set the notification URL to <API_PUBLIC_URL>/api/v1/webhooks/amwal.
# "stripe" uses Stripe test keys (https://dashboard.stripe.com/test/apikeys).
PAYMENT_PROVIDER=fake
AMWAL_ENV=uat
AMWAL_MERCHANT_ID=replace_me
AMWAL_TERMINAL_ID=replace_me
AMWAL_SECURE_KEY=replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Product images: "fake" issues placeholder upload URLs; "r2" needs the R2 values below.
IMAGE_STORAGE=fake
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=hp-product-images-dev
CDN_BASE_URL=http://localhost:4000/dev-cdn

# Report exports (CSV/XLSX): "fake" keeps files in REPORTS_DIR (default: OS temp dir) and
# serves them through an HMAC-signed API link; "r2" needs a PRIVATE bucket (not the image one).
REPORT_STORAGE=fake
R2_REPORTS_BUCKET=
REPORTS_DIR=
API_PUBLIC_URL=http://localhost:4000

# --- Worker (apps/worker) ---
# Local dev sends mail to Mailpit (UI at http://localhost:8035)
SMTP_URL=smtp://localhost:1035
RESEND_API_KEY=
# Optional: where low-stock alerts are sent
LOW_STOCK_ALERT_EMAIL=
MAIL_FROM="PAISLEY art <orders@localhost>"

# --- Seed ---
# The seed prints a one-time invite link for this SUPER_ADMIN (password + 2FA are set there)
SEED_ADMIN_EMAIL=admin@example.test

# --- Frontends (apps/web, apps/admin) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Observability (optional locally) ---
SENTRY_DSN=
