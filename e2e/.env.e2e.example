# E2E environment. Copy to .env.e2e to override; without it these defaults are used.
# Values here are local-only and obviously fake. Secrets the API needs (JWT, cookie,
# TOTP encryption key) are generated at random each time the servers start.

# A dedicated database. Its name MUST end in _e2e_test (the scripts refuse anything else).
# It is created by `prisma migrate deploy` if missing, then seeded. Never reset.
# Credentials are the local-only ones from infra/docker-compose.yml.
E2E_DATABASE_URL=postgresql://hp:hp_local_dev_only@127.0.0.1:5442/hearthandpan_e2e_test

# Ports for the E2E servers (kept clear of the dev servers on 4000/3000/3001)
E2E_API_PORT=4100
E2E_WEB_PORT=3100
E2E_ADMIN_PORT=3101

# Mailpit from infra/docker-compose.yml: SMTP for the API, HTTP API for the tests
E2E_SMTP_URL=smtp://127.0.0.1:1035
E2E_MAILPIT_URL=http://127.0.0.1:8035

# "copy" (default) builds the Next apps from a snapshot under e2e/.apps so it never touches
# apps/*/.next; "inplace" builds in apps/web and apps/admin (fine on a clean CI runner).
E2E_BUILD_MODE=copy
# Set to 1 to reuse the last build in e2e/.apps (skips `next build`).
E2E_SKIP_BUILD=0
