{
  "name": "@hp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:int": "vitest run -c vitest.int.config.ts",
    "db:migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=../../.env node_modules/prisma/build/index.js db seed",
    "db:studio": "node --env-file=../../.env node_modules/prisma/build/index.js studio",
    "generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "import:albaleed": "tsx --env-file=../../.env scripts/import-albaleed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@hp/contracts": "workspace:*",
    "@prisma/client": "^6.16.0",
    "@sentry/node": "10.75.3",
    "argon2": "^0.41.1",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "~10.2.1",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limiter-flexible": "^5.0.5",
    "sanitize-html": "^2.18.1",
    "stripe": "^17.7.0",
    "write-excel-file": "4.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hp/config": "workspace:*",
    "@hp/test-utils": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.16.0",
    "sharp": "0.35.5",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
